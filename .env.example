# ============================================================================
# AlphaForge — RELAXED PAPER TEST PROFILE
# ============================================================================
# Purpose: generate more PAPER/burn-in evidence while keeping LIVE disabled.
# Copy to .env only for PAPER testing. Do NOT use this profile for LIVE.
# Numeric quality/rate limits are intentionally relaxed; execution evidence
# integrity remains fail-closed (unknown execution context is still rejected).
#
# #374 note: reject execution parity is code-level, not an env switch.
# On current post-#374 code, fresh attributable reject outcomes should persist
# EXPECTED_FILL_RUNTIME_PARITY and all_failed_gates provenance automatically.
#
# Existing shell/process environment overrides .env. Start a NEW campaign after
# changing this file; do not mix old campaign evidence with the new profile.
# ============================================================================


# ---------------------------------------------------------------------------
# MODE & HARD SAFETY — PAPER ONLY
# ---------------------------------------------------------------------------
ALPHAFORGE_EXECUTION_MODE=PAPER
ALPHAFORGE_ENABLE_PAPER_TRADING=true
ALPHAFORGE_ENABLE_LIVE_TRADING=false
ALPHAFORGE_ALLOW_LIVE_ORDERS=false
ALPHAFORGE_OPERATOR_LIVE_ACKNOWLEDGED=false
ALPHAFORGE_REQUIRE_LIVE_QUALIFICATION=true
ALPHAFORGE_REQUIRE_EXCHANGE_CONNECTIVITY_FOR_LIVE=true
ALPHAFORGE_REQUIRED_LIVE_EXCHANGES=binance
ALPHAFORGE_EXCHANGE_CONNECTIVITY_TIMEOUT_SEC=2.0
ALPHAFORGE_ENABLE_CANARY_MODE=false
ALPHAFORGE_GLOBAL_KILL_SWITCH=false
ALPHAFORGE_ENABLE_SHADOW_MODE=false

# ---------------------------------------------------------------------------
# PAPER RUNTIME / OPERATIONS
# ---------------------------------------------------------------------------
ALPHAFORGE_DATABASE_URL=sqlite+pysqlite:///data/runtime/alphaforge_runtime.db
ALPHAFORGE_PERSISTENCE_ENABLED=true
ALPHAFORGE_SCAN_INTERVAL_SEC=1.0
ALPHAFORGE_HEARTBEAT_INTERVAL_SEC=30.0
ALPHAFORGE_LOG_LEVEL=INFO
ALPHAFORGE_MAX_SYMBOLS_PER_SCAN=10
ALPHAFORGE_MAX_REJECT_LOG_ENTRIES=10000
ALPHAFORGE_PROVIDER_TRANSIENT_OUTAGE_GRACE_SECONDS=300.0
ALPHAFORGE_MAX_CLOCK_SKEW_MS=5000

# ---------------------------------------------------------------------------
# SIGNAL / QUALITY GATES — RELAXED FOR PAPER TEST
# ---------------------------------------------------------------------------
# Relaxed for sample generation: score=0.10, raw RR=1.10, effective RR=0.90.
ALPHAFORGE_MIN_SIGNAL_SCORE=0.10
ALPHAFORGE_MIN_RR=1.10
MIN_EFFECTIVE_RR=0.90
ALPHAFORGE_BLOCK_UNKNOWN_EXPECTANCY=false
ALPHAFORGE_BLOCK_CHOP_MARKET=true
ALPHAFORGE_REQUIRE_REGIME_ALIGNMENT=true
ALPHAFORGE_ENABLE_ORDERBOOK_FILTER=false

# ---------------------------------------------------------------------------
# STOP / ATR / GEOMETRY
# ---------------------------------------------------------------------------
ALPHAFORGE_MIN_SL_PCT=0.10
ALPHAFORGE_MAX_SL_PCT=2.50
ALPHAFORGE_MIN_ATR_PCT=0.10
ALPHAFORGE_MAX_ATR_PCT=5.0
ALPHAFORGE_STOP_TOO_WIDE_HARD_REJECT=true
ALPHAFORGE_STOP_TOO_WIDE_SOFT_SCORE_MIN=0.65
ALPHAFORGE_STOP_TOO_WIDE_SOFT_EFFECTIVE_RR_MIN=1.20
ALPHAFORGE_STOP_TOO_WIDE_MAX_RISK_SCALE=0.50
ALPHAFORGE_STOP_TOO_WIDE_EXTREME_MULT=2.0

# ---------------------------------------------------------------------------
# EXECUTION COST / LIQUIDITY / MARKET QUALITY
# ---------------------------------------------------------------------------
# Looser bounds, but missing critical execution context still fails closed.
ALPHAFORGE_MAX_SPREAD_PCT=0.10
ALPHAFORGE_MAX_EXPECTED_SLIPPAGE_PCT=0.10
ALPHAFORGE_MAX_TOTAL_COST_PCT=0.30
ALPHAFORGE_MAX_VOLATILITY_PENALTY_PCT=0.30
ALPHAFORGE_MAX_ABS_FUNDING_RATE_PCT=0.002
ALPHAFORGE_MAX_LATENCY_MS=5000
ALPHAFORGE_MIN_LIQUIDITY_SCORE=0.20
MIN_LIQUIDITY_USD=1000000.0
ALPHAFORGE_REJECT_UNKNOWN_EXECUTION_CONTEXT=true
ALPHAFORGE_PAPER_FEE_BPS=4.0
ALPHAFORGE_PAPER_EXECUTION_LATENCY_MS=50.0

# ---------------------------------------------------------------------------
# PAPER RISK / EXPOSURE / TRADE LIMITS — RELAXED
# ---------------------------------------------------------------------------
# PAPER-only capacity is widened to avoid starving the evidence sample.
ALPHAFORGE_MAX_CONCURRENT_POSITIONS=10
ALPHAFORGE_MAX_NOTIONAL_EXPOSURE=5000.0
ALPHAFORGE_MAX_SYMBOL_NOTIONAL=1000.0
ALPHAFORGE_MAX_DAILY_LOSS_PCT=0.20
ALPHAFORGE_MAX_TRADES_GLOBAL_PER_DAY=100
ALPHAFORGE_MAX_TRADES_SYMBOL_PER_DAY=50
ALPHAFORGE_SYMBOL_COOLDOWN_SEC=0.0
ALPHAFORGE_SYMBOL_LOSS_STREAK_LIMIT=25
ALPHAFORGE_GLOBAL_LOSS_STREAK_LIMIT=50
ALPHAFORGE_STALE_MARKET_DATA_SEC=30.0

# ---------------------------------------------------------------------------
# MTF / STATE DIRECTION / SHADOW
# ---------------------------------------------------------------------------
# MTF execution and state-direction shadow remain non-authoritative.
ALPHAFORGE_REGIME_TIMEFRAME=1h
ALPHAFORGE_SETUP_TIMEFRAME=15m
ALPHAFORGE_EXECUTION_TIMEFRAME=1m
ALPHAFORGE_PAPER_DECISION_TIMEFRAME=
ALPHAFORGE_MTF_GUIDED_SIGNAL_GENERATION_ENABLED=true
MTF_EXECUTION_CONFIRMATION_MODE=SHADOW
ALPHAFORGE_REGIME_DIRECTION_THRESHOLD=0.0003
ALPHAFORGE_SETUP_DIRECTION_THRESHOLD=0.0002
ALPHAFORGE_EXECUTION_DIRECTION_THRESHOLD=0.0002
ALPHAFORGE_ENABLE_STATE_DIRECTION_RESOLUTION=false
ALPHAFORGE_ENABLE_STATE_DIRECTION_SHADOW_EVALUATION=true

# ---------------------------------------------------------------------------
# REJECT FORWARD OUTCOME / #374 EVIDENCE
# ---------------------------------------------------------------------------
# Keep enough horizon for meaningful TP/SL forward labels.
ALPHAFORGE_REJECT_FORWARD_HORIZON_BARS=240
ALPHAFORGE_REJECT_RESOLVER_INTERVAL_SEC=30

# ---------------------------------------------------------------------------
# BINANCE PUBLIC / READ-ONLY RECONCILIATION
# ---------------------------------------------------------------------------
BINANCE_ENVIRONMENT=production
BINANCE_BASE_URL=
BINANCE_WS_URL=
ALPHAFORGE_BINANCE_MARKET_DATA_BASE_URL=https://fapi.binance.com
BINANCE_DEFAULT_MARKET_TYPE=USD_M
BINANCE_DEFAULT_QUOTE_ASSET=USDT
ALPHAFORGE_BINANCE_RECV_WINDOW_MS=5000
BINANCE_REQUEST_TIMEOUT_SEC=2.0
ALPHAFORGE_ENABLE_BINANCE_READONLY_RECONCILIATION=true
ALPHAFORGE_BINANCE_RECONCILIATION_TRADE_LOOKBACK_MS=3600000
ALPHAFORGE_RECONCILIATION_INTERVAL_SEC=5.0
ALPHAFORGE_RECONCILIATION_TIMEOUT_SEC=2.0
ALPHAFORGE_RECONCILIATION_POSITION_EPSILON=0.00000001
ALPHAFORGE_RECONCILIATION_MAX_FILL_SYMBOLS=10

# ---------------------------------------------------------------------------
# HYPERLIQUID PUBLIC MARKET DATA
# ---------------------------------------------------------------------------
HYPERLIQUID_ENABLED=true
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# ---------------------------------------------------------------------------
# AGENT GRAPH — SHADOW / NON-AUTHORITATIVE
# ---------------------------------------------------------------------------
ALPHAFORGE_AGENT_GRAPH_ENABLED=false
ALPHAFORGE_AGENT_GRAPH_SHADOW=true
ALPHAFORGE_AGENT_GRAPH_MAX_STEPS=12
ALPHAFORGE_AGENT_GRAPH_MAX_REFLECTION_RETRIES=1
ALPHAFORGE_AGENT_GRAPH_STAGE_TIMEOUT_SECONDS=5
ALPHAFORGE_AGENT_GRAPH_PERSIST_TRACES=true
ALPHAFORGE_AGENT_GRAPH_MAX_PENDING_RUNS=64
ALPHAFORGE_AGENT_GRAPH_DATABASE_URL=sqlite+pysqlite:///data/runtime/alphaforge_agent_shadow.db

# ---------------------------------------------------------------------------
# NOTIFICATIONS
# ---------------------------------------------------------------------------
ALPHAFORGE_ENABLE_TELEGRAM=false

# ---------------------------------------------------------------------------
# BACKTEST — GENERAL
# ---------------------------------------------------------------------------
ALPHAFORGE_BACKTEST_TIMEFRAME=1m
ALPHAFORGE_BACKTEST_LAST_N_DAYS=7
ALPHAFORGE_BACKTEST_TOP_N=100
ALPHAFORGE_BACKTEST_OUTPUT_DIR=data/backtest
ALPHAFORGE_BACKTEST_INITIAL_BALANCE=1000.0
ALPHAFORGE_BACKTEST_RISK_PCT=1.0
ALPHAFORGE_BACKTEST_MAX_TRADES=0
ALPHAFORGE_BACKTEST_MAX_ACCEPTED_TRADES_PER_DAY=0
ALPHAFORGE_BACKTEST_MAX_SYMBOL_TRADES_PER_DAY=0
ALPHAFORGE_BACKTEST_USE_EXECUTION_COSTS=true
ALPHAFORGE_BACKTEST_EXPORT_CONFIG_SNAPSHOT=true
ALPHAFORGE_BACKTEST_STRATEGY_GUARDRAILS_ENABLED=true
ALPHAFORGE_BACKTEST_STRATEGY_PROFILE=DEFAULT_FILTERS
ALPHAFORGE_BACKTEST_HIGH_VOL_ACCEPTANCE_GUARD=true
ALPHAFORGE_BACKTEST_SCORE10_SL_DOMINANCE_GUARD=true
ALPHAFORGE_BACKTEST_MAX_CONSECUTIVE_SL_PAUSE=4
ALPHAFORGE_BACKTEST_MAX_DRAWDOWN_PCT_FOR_PROFILE_PASS=12.0
ALPHAFORGE_BACKTEST_MAX_LOSS_STREAK_FOR_PROFILE_PASS=6
ALPHAFORGE_BACKTEST_MIN_PROFIT_FACTOR_FOR_PROFILE_PASS=1.2

# ---------------------------------------------------------------------------
# BACKTEST — FILTER SWITCHES
# ---------------------------------------------------------------------------
ALPHAFORGE_BACKTEST_FILTER_LOW_SCORE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_RR_TOO_LOW_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_STOP_TOO_WIDE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_TOO_CHOPPY_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_WEAK_TREND_NO_RANGE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_REGIME_MISMATCH_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_PANIC_CONDITIONS_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_DAILY_SYMBOL_TRADE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# BACKTEST — PORTFOLIO / RISK OVERRIDES (ADDED)
# ---------------------------------------------------------------------------
ALPHAFORGE_BACKTEST_MAX_OPEN_POSITIONS=20
ALPHAFORGE_BACKTEST_MAX_CONCURRENT_POSITIONS=20
ALPHAFORGE_BACKTEST_MAX_NOTIONAL_EXPOSURE=1000.0
ALPHAFORGE_BACKTEST_MAX_SYMBOL_NOTIONAL=500.0
ALPHAFORGE_BACKTEST_MAX_DAILY_LOSS_PCT=0.20
ALPHAFORGE_BACKTEST_MAX_ROLLING_DRAWDOWN_PCT=0.30
ALPHAFORGE_BACKTEST_MAX_CORRELATION_GROUP_EXPOSURE=1000.0
ALPHAFORGE_BACKTEST_MAX_CORRELATED_POSITIONS=10
ALPHAFORGE_BACKTEST_MAX_TRADES_SYMBOL_PER_DAY=100
ALPHAFORGE_BACKTEST_MAX_TRADES_GLOBAL_PER_DAY=200
ALPHAFORGE_BACKTEST_MAX_SAME_SIDE_EXPOSURE=1000.0
ALPHAFORGE_BACKTEST_MAX_NET_EXPOSURE=1000.0
ALPHAFORGE_BACKTEST_SAFE_TRADES_PER_DAY=100.0

# ---------------------------------------------------------------------------
# BACKTEST — SHORT BREAKDOWN RESCUE / DIAGNOSTICS
# ---------------------------------------------------------------------------
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ENABLED=false
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ALLOWED_REASONS=LOW_SCORE,STOP_TOO_WIDE,DAILY_SYMBOL_TRADE_LIMIT
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MAX_PER_DAY=1
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_EFFECTIVE_RR=1.1
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_SHADOW_EXPECTANCY=0.0
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_SIZE_MULTIPLIER=0.25
ALPHAFORGE_BACKTEST_SHORT_LOW_SCORE_BREAKDOWN_DIAGNOSTIC_SYMBOLS=BTCUSDT,ETHUSDT

# ---------------------------------------------------------------------------
# DEPRECATED ALIASES — KEEP EMPTY
# ---------------------------------------------------------------------------
# Canonical names above win. Non-empty conflicting aliases can fail config audit.
BINANCE_RECV_WINDOW_MS=
ALPHAFORGE_DB_URL=
ALPHAFORGE_MAX_OPEN_POSITIONS=
ALPHAFORGE_MIN_ACCEPT_SCORE=
ALPHAFORGE_MIN_EFFECTIVE_RR=
BINANCE_TESTNET=
DATABASE_URL=
ENABLE_ORDERBOOK_FILTER=
ENABLE_REGIME_FILTER=
EXECUTION_MODE=
MAX_EXPECTED_SLIPPAGE_PCT=
MAX_SPREAD_PCT=
MAX_TOTAL_COST_PCT=
MAX_VOLATILITY_PENALTY_PCT=
MIN_LIQUIDITY_SCORE=
REJECT_UNKNOWN_EXECUTION_CONTEXT=

# ============================================================================
# SECRETS / CREDENTIALS — LAST SECTION BY DESIGN
# ============================================================================
# Never commit real values. Binance credentials must be READ-ONLY for PAPER
# reconciliation; do not grant order/trading permissions.
BINANCE_API_KEY=your_read_only_binance_api_key
BINANCE_API_SECRET=your_read_only_binance_api_secret
# Telegram is disabled above; fill only if diagnostic delivery is enabled.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
