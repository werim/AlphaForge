# Generated from alphaforge.config_registry. Every key is classified exactly once.
# Mode profile: PAPER. Existing process environment overrides repository .env.

# WIRED — parsed and consumed operational settings
# Export config_snapshot.json with backtest runs.
ALPHAFORGE_BACKTEST_EXPORT_CONFIG_SNAPSHOT=true
# Default dashboard backtest horizon.
ALPHAFORGE_BACKTEST_LAST_N_DAYS=7
# Optional BACKTEST accepted/day cap; 0 disables.
ALPHAFORGE_BACKTEST_MAX_ACCEPTED_TRADES_PER_DAY=0
# Optional BACKTEST symbol/day cap; 0 disables.
ALPHAFORGE_BACKTEST_MAX_SYMBOL_TRADES_PER_DAY=0
# Optional total backtest trade cap; 0 disables.
ALPHAFORGE_BACKTEST_MAX_TRADES=0
# BACKTEST-only SHORT_BREAKDOWN_RESCUE experiment; disabled by default and does not affect PAPER/LIVE.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ENABLED=false
# Default backtest candle interval.
ALPHAFORGE_BACKTEST_TIMEFRAME=1m
# Backtest universe size cap.
ALPHAFORGE_BACKTEST_TOP_N=100
# Use execution-cost context in backtests when available.
ALPHAFORGE_BACKTEST_USE_EXECUTION_COSTS=true
# Reject candidates marked as chop.
ALPHAFORGE_BLOCK_CHOP_MARKET=true
# Reject candidates without expectancy context.
ALPHAFORGE_BLOCK_UNKNOWN_EXPECTANCY=true
# Runtime persistence database URL.
ALPHAFORGE_DATABASE_URL=sqlite:///./alphaforge.db
# Requests LIVE runtime availability; readiness guard still applies.
ALPHAFORGE_ENABLE_LIVE_TRADING=false
# Allows PAPER runtime startup.
ALPHAFORGE_ENABLE_PAPER_TRADING=true
# Canonical engine mode.
ALPHAFORGE_EXECUTION_MODE=PAPER
# Emergency stop for runtime order flow.
ALPHAFORGE_GLOBAL_KILL_SWITCH=false
# Global loss streak runtime block threshold.
ALPHAFORGE_GLOBAL_LOSS_STREAK_LIMIT=5
# Maximum absolute funding-rate percent.
ALPHAFORGE_MAX_ABS_FUNDING_RATE_PCT=0.001
# Maximum ATR percent when ATR exists.
ALPHAFORGE_MAX_ATR_PCT=3.0
# Maximum expected slippage percent.
ALPHAFORGE_MAX_EXPECTED_SLIPPAGE_PCT=0.05
# Maximum market-data/execution latency when available.
ALPHAFORGE_MAX_LATENCY_MS=2500
# Maximum stop distance percent.
ALPHAFORGE_MAX_SL_PCT=1.5
# Maximum spread percent.
ALPHAFORGE_MAX_SPREAD_PCT=0.05
# Maximum total explicit execution cost percent before rejection.
ALPHAFORGE_MAX_TOTAL_COST_PCT=0.2
# Runtime global daily trade cap; ignored by BACKTEST by default.
ALPHAFORGE_MAX_TRADES_GLOBAL_PER_DAY=10
# Runtime per-symbol daily trade cap; ignored by BACKTEST by default.
ALPHAFORGE_MAX_TRADES_SYMBOL_PER_DAY=2
# Maximum RR volatility penalty before rejection.
ALPHAFORGE_MAX_VOLATILITY_PENALTY_PCT=0.2
# Minimum ATR percent when ATR exists.
ALPHAFORGE_MIN_ATR_PCT=0.25
# Minimum normalized liquidity score before rejection.
ALPHAFORGE_MIN_LIQUIDITY_SCORE=0.3
# Minimum raw risk/reward.
ALPHAFORGE_MIN_RR=1.2
# Minimum normalized signal score.
ALPHAFORGE_MIN_SIGNAL_SCORE=0.62
# Minimum stop distance percent.
ALPHAFORGE_MIN_SL_PCT=0.15
# Reject when critical execution context is unavailable instead of treating missing values as zero.
ALPHAFORGE_REJECT_UNKNOWN_EXECUTION_CONTEXT=true
# Require readiness qualification before LIVE.
ALPHAFORGE_REQUIRE_LIVE_QUALIFICATION=true
# Require setup/regime alignment.
ALPHAFORGE_REQUIRE_REGIME_ALIGNMENT=true
# Extreme wide-stop multiple.
ALPHAFORGE_STOP_TOO_WIDE_EXTREME_MULT=1.5
# Hard-reject wide stops unless softening applies.
ALPHAFORGE_STOP_TOO_WIDE_HARD_REJECT=true
# Maximum risk scale for softened wide stops.
ALPHAFORGE_STOP_TOO_WIDE_MAX_RISK_SCALE=0.5
# Minimum effective RR for wide-stop softening.
ALPHAFORGE_STOP_TOO_WIDE_SOFT_EFFECTIVE_RR_MIN=1.75
# Minimum score for wide-stop softening.
ALPHAFORGE_STOP_TOO_WIDE_SOFT_SCORE_MIN=9.0
# Runtime symbol cooldown seconds.
ALPHAFORGE_SYMBOL_COOLDOWN_SEC=120.0
# Symbol loss streak runtime block threshold.
ALPHAFORGE_SYMBOL_LOSS_STREAK_LIMIT=3
# Read-only reconciliation API key.
BINANCE_API_KEY=your_binance_api_key
# Read-only reconciliation API secret.
BINANCE_API_SECRET=your_binance_api_secret
# Optional explicit Binance USD-M REST override.
BINANCE_BASE_URL=
# Supported Binance Futures market type (USD_M).
BINANCE_DEFAULT_MARKET_TYPE=USD_M
# Quote asset used by the Binance market scanner.
BINANCE_DEFAULT_QUOTE_ASSET=USDT
# Binance USD-M Futures environment selector.
BINANCE_ENVIRONMENT=production
# Signed request receive window.
BINANCE_RECV_WINDOW_MS=5000
# Binance HTTP request timeout.
BINANCE_REQUEST_TIMEOUT_SEC=2.0
# Optional explicit Binance USD-M websocket override.
BINANCE_WS_URL=
# Minimum execution-adjusted RR.
MIN_EFFECTIVE_RR=1.6
# Minimum 24h liquidity.
MIN_LIQUIDITY_USD=5000000.0

# DEPRECATED ALIASES — canonical names above win within the same source.
# ALPHAFORGE_BINANCE_RECV_WINDOW_MS -> BINANCE_RECV_WINDOW_MS (deprecated; leave empty unless migrating)
ALPHAFORGE_BINANCE_RECV_WINDOW_MS=
# ALPHAFORGE_DB_URL -> ALPHAFORGE_DATABASE_URL (deprecated; leave empty unless migrating)
ALPHAFORGE_DB_URL=
# ALPHAFORGE_MIN_ACCEPT_SCORE -> ALPHAFORGE_MIN_SIGNAL_SCORE (deprecated; leave empty unless migrating)
ALPHAFORGE_MIN_ACCEPT_SCORE=
# ALPHAFORGE_MIN_EFFECTIVE_RR -> MIN_EFFECTIVE_RR (deprecated; leave empty unless migrating)
ALPHAFORGE_MIN_EFFECTIVE_RR=
# BINANCE_TESTNET -> BINANCE_ENVIRONMENT (deprecated; leave empty unless migrating)
BINANCE_TESTNET=
# DATABASE_URL -> ALPHAFORGE_DATABASE_URL (deprecated; leave empty unless migrating)
DATABASE_URL=
# EXECUTION_MODE -> ALPHAFORGE_EXECUTION_MODE (deprecated; leave empty unless migrating)
EXECUTION_MODE=
# MAX_EXPECTED_SLIPPAGE_PCT -> ALPHAFORGE_MAX_EXPECTED_SLIPPAGE_PCT (deprecated; leave empty unless migrating)
MAX_EXPECTED_SLIPPAGE_PCT=
# MAX_SPREAD_PCT -> ALPHAFORGE_MAX_SPREAD_PCT (deprecated; leave empty unless migrating)
MAX_SPREAD_PCT=
# MAX_TOTAL_COST_PCT -> ALPHAFORGE_MAX_TOTAL_COST_PCT (deprecated; leave empty unless migrating)
MAX_TOTAL_COST_PCT=
# MAX_VOLATILITY_PENALTY_PCT -> ALPHAFORGE_MAX_VOLATILITY_PENALTY_PCT (deprecated; leave empty unless migrating)
MAX_VOLATILITY_PENALTY_PCT=
# MIN_LIQUIDITY_SCORE -> ALPHAFORGE_MIN_LIQUIDITY_SCORE (deprecated; leave empty unless migrating)
MIN_LIQUIDITY_SCORE=
# REJECT_UNKNOWN_EXECUTION_CONTEXT -> ALPHAFORGE_REJECT_UNKNOWN_EXECUTION_CONTEXT (deprecated; leave empty unless migrating)
REJECT_UNKNOWN_EXECUTION_CONTEXT=

# RESERVED / NON-OPERATIONAL — unsupported; supplying a value produces an audit warning.
ALPHAFORGE_ALLOW_LIVE_ORDERS=false
