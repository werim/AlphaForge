# Generated from alphaforge.config_registry. Every key is classified exactly once.
# Mode profile: PAPER. Existing process environment overrides repository .env.

# WIRED — parsed, validated, consumed, and behaviorally tested settings
# Export config_snapshot.json with backtest runs. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_EXPORT_CONFIG_SNAPSHOT=true
# Enable per-symbol daily cap rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_DAILY_SYMBOL_TRADE_LIMIT_ENABLED=true
# Enable LOW_SCORE rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_LOW_SCORE_ENABLED=true
# Enable PANIC_CONDITIONS rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_PANIC_CONDITIONS_ENABLED=true
# Enable REGIME_MISMATCH rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_REGIME_MISMATCH_ENABLED=true
# Enable RR_TOO_LOW rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_RR_TOO_LOW_ENABLED=true
# Enable STOP_TOO_WIDE rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_STOP_TOO_WIDE_ENABLED=true
# Enable TOO_CHOPPY rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_TOO_CHOPPY_ENABLED=true
# Enable weak-trend rejection. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_FILTER_WEAK_TREND_NO_RANGE_ENABLED=true
# Enable high-volatility acceptance guard. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_HIGH_VOL_ACCEPTANCE_GUARD=true
# Backtest starting balance. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_INITIAL_BALANCE=1000.0
# Default dashboard backtest horizon. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_LAST_N_DAYS=7
# Optional BACKTEST accepted/day cap; 0 disables. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_ACCEPTED_TRADES_PER_DAY=0
# Pause threshold for consecutive stop losses. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_CONSECUTIVE_SL_PAUSE=4
# Maximum profile drawdown percent. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_DRAWDOWN_PCT_FOR_PROFILE_PASS=12.0
# Maximum profile loss streak. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_LOSS_STREAK_FOR_PROFILE_PASS=6
# Optional BACKTEST symbol/day cap; 0 disables. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_SYMBOL_TRADES_PER_DAY=0
# Optional total backtest trade cap; 0 disables. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MAX_TRADES=0
# Minimum profile profit factor. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_MIN_PROFIT_FACTOR_FOR_PROFILE_PASS=1.2
# Backtest artifact output directory. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_OUTPUT_DIR=data/backtest
# Backtest risk percentage per accepted order. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_RISK_PCT=1.0
# Enable score-10 stop-loss dominance guard. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SCORE10_SL_DOMINANCE_GUARD=true
# Comma-separated rescue-eligible rejects. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ALLOWED_REASONS=LOW_SCORE,STOP_TOO_WIDE,DAILY_SYMBOL_TRADE_LIMIT
# BACKTEST-only SHORT_BREAKDOWN_RESCUE experiment; disabled by default and does not affect PAPER/LIVE. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ENABLED=false
# Daily rescue cap. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MAX_PER_DAY=1
# Minimum rescue effective RR. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_EFFECTIVE_RR=1.1
# Minimum rescue shadow expectancy. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_SHADOW_EXPECTANCY=0.0
# Rescue risk-size multiplier. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_SIZE_MULTIPLIER=0.25
# Diagnostic symbol allowlist. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_SHORT_LOW_SCORE_BREAKDOWN_DIAGNOSTIC_SYMBOLS=BTCUSDT,ETHUSDT
# Enable strategy-profile quality guardrails. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_STRATEGY_GUARDRAILS_ENABLED=true
# Backtest strategy profile name. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_STRATEGY_PROFILE=DEFAULT_FILTERS
# Default backtest candle interval. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_TIMEFRAME=1m
# Backtest universe size cap. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_TOP_N=100
# Use execution-cost context in backtests when available. Consumer: backtest_order.run_backtest. Modes: BACKTEST.
ALPHAFORGE_BACKTEST_USE_EXECUTION_COSTS=true
# Read-only fill lookback window. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_BINANCE_RECONCILIATION_TRADE_LOOKBACK_MS=3600000
# Reject candidates marked as chop. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_BLOCK_CHOP_MARKET=true
# Reject candidates without expectancy context. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_BLOCK_UNKNOWN_EXPECTANCY=true
# Runtime persistence database URL. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_DATABASE_URL=sqlite:///./alphaforge.db
# Enable signed read-only Binance reconciliation. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_ENABLE_BINANCE_READONLY_RECONCILIATION=false
# Request canary mode; readiness gates remain authoritative. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: LIVE.
ALPHAFORGE_ENABLE_CANARY_MODE=false
# Requests LIVE runtime availability; readiness guard still applies. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: LIVE.
ALPHAFORGE_ENABLE_LIVE_TRADING=false
# Allows PAPER runtime startup. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER.
ALPHAFORGE_ENABLE_PAPER_TRADING=true
# Enable shadow-only runtime behavior. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_ENABLE_SHADOW_MODE=false
# Enable Telegram diagnostic alert delivery. Consumer: alphaforge.telegram_alert_delivery.telegram_alert_provider_from_config. Modes: PAPER,LIVE.
ALPHAFORGE_ENABLE_TELEGRAM=false
# Canonical engine mode. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_EXECUTION_MODE=PAPER
# Emergency stop for runtime order flow. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_GLOBAL_KILL_SWITCH=false
# Global loss streak runtime block threshold. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_GLOBAL_LOSS_STREAK_LIMIT=5
# Seconds between runtime heartbeats. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_HEARTBEAT_INTERVAL_SEC=30.0
# Runtime logging threshold. Consumer: alphaforge.runtime.main. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_LOG_LEVEL=INFO
# Maximum absolute funding-rate percent. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_ABS_FUNDING_RATE_PCT=0.001
# Maximum ATR percent when ATR exists. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_ATR_PCT=3.0
# Concurrent-position hard cap. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_CONCURRENT_POSITIONS=3
# Daily realized-loss fraction that blocks new risk. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_DAILY_LOSS_PCT=0.05
# Maximum expected slippage percent. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_EXPECTED_SLIPPAGE_PCT=0.05
# Maximum market-data/execution latency when available. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_LATENCY_MS=2500
# Portfolio notional hard cap. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_NOTIONAL_EXPOSURE=100000.0
# In-memory reject log cap. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_REJECT_LOG_ENTRIES=1000
# Maximum stop distance percent. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_SL_PCT=1.5
# Maximum spread percent. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_SPREAD_PCT=0.05
# Maximum selected symbols per scan. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_SYMBOLS_PER_SCAN=5
# Per-symbol notional hard cap. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_SYMBOL_NOTIONAL=50000.0
# Maximum total explicit execution cost percent before rejection. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_TOTAL_COST_PCT=0.2
# Runtime global daily trade cap; ignored by BACKTEST by default. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_TRADES_GLOBAL_PER_DAY=10
# Runtime per-symbol daily trade cap; ignored by BACKTEST by default. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_MAX_TRADES_SYMBOL_PER_DAY=2
# Maximum RR volatility penalty before rejection. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MAX_VOLATILITY_PENALTY_PCT=0.2
# Minimum ATR percent when ATR exists. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MIN_ATR_PCT=0.25
# Minimum normalized liquidity score before rejection. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MIN_LIQUIDITY_SCORE=0.3
# Minimum raw risk/reward. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MIN_RR=1.2
# Minimum normalized signal score. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MIN_SIGNAL_SCORE=0.62
# Minimum stop distance percent. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_MIN_SL_PCT=0.15
# Additional deny-by-default operator acknowledgement. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: LIVE.
ALPHAFORGE_OPERATOR_LIVE_ACKNOWLEDGED=false
# Enable persistence writes. Consumer: alphaforge.persistence.init_db. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_PERSISTENCE_ENABLED=true
# Runtime reconciliation interval. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_RECONCILIATION_INTERVAL_SEC=5.0
# Runtime reconciliation timeout. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_RECONCILIATION_TIMEOUT_SEC=2.0
# Reject when critical execution context is unavailable instead of treating missing values as zero. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_REJECT_UNKNOWN_EXECUTION_CONTEXT=true
# Require readiness qualification before LIVE. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: LIVE.
ALPHAFORGE_REQUIRE_LIVE_QUALIFICATION=true
# Require setup/regime alignment. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_REQUIRE_REGIME_ALIGNMENT=true
# Seconds between runtime scans. Consumer: alphaforge.runtime._build_runtime_from_env. Modes: PAPER,LIVE.
ALPHAFORGE_SCAN_INTERVAL_SEC=1.0
# Maximum market-data age. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_STALE_MARKET_DATA_SEC=15.0
# Extreme wide-stop multiple. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_STOP_TOO_WIDE_EXTREME_MULT=1.5
# Hard-reject wide stops unless softening applies. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_STOP_TOO_WIDE_HARD_REJECT=true
# Maximum risk scale for softened wide stops. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_STOP_TOO_WIDE_MAX_RISK_SCALE=0.5
# Minimum effective RR for wide-stop softening. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_STOP_TOO_WIDE_SOFT_EFFECTIVE_RR_MIN=1.75
# Minimum score for wide-stop softening. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
ALPHAFORGE_STOP_TOO_WIDE_SOFT_SCORE_MIN=9.0
# Runtime symbol cooldown seconds. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_SYMBOL_COOLDOWN_SEC=120.0
# Symbol loss streak runtime block threshold. Consumer: alphaforge.runtime.RuntimeOrchestrator._evaluate_runtime_risk. Modes: PAPER,LIVE.
ALPHAFORGE_SYMBOL_LOSS_STREAK_LIMIT=3
# Read-only reconciliation API key. Consumer: alphaforge.binance_reconciliation_provider. Modes: PAPER,LIVE.
BINANCE_API_KEY=your_binance_api_key
# Read-only reconciliation API secret. Consumer: alphaforge.binance_reconciliation_provider. Modes: PAPER,LIVE.
BINANCE_API_SECRET=your_binance_api_secret
# Optional explicit Binance USD-M REST override. Consumer: scanner, connectivity, reconciliation, historical provider. Modes: BACKTEST,PAPER,LIVE.
BINANCE_BASE_URL=
# Supported Binance Futures market type (USD_M). Consumer: Binance providers. Modes: BACKTEST,PAPER,LIVE.
BINANCE_DEFAULT_MARKET_TYPE=USD_M
# Quote asset used by the Binance market scanner. Consumer: alphaforge.exchange_market_scanner. Modes: BACKTEST,PAPER,LIVE.
BINANCE_DEFAULT_QUOTE_ASSET=USDT
# Binance USD-M Futures environment selector. Consumer: alphaforge.env_contract.resolve_binance_environment. Modes: PAPER,LIVE.
BINANCE_ENVIRONMENT=production
# Signed request receive window. Consumer: alphaforge.binance_reconciliation_provider. Modes: PAPER,LIVE.
BINANCE_RECV_WINDOW_MS=5000
# Binance HTTP request timeout. Consumer: scanner, connectivity, reconciliation. Modes: PAPER,LIVE.
BINANCE_REQUEST_TIMEOUT_SEC=2.0
# Optional explicit Binance USD-M websocket override. Consumer: connectivity and environment consistency. Modes: PAPER,LIVE.
BINANCE_WS_URL=
# Hyperliquid public API URL. Consumer: alphaforge.exchange_market_scanner._scan_hyperliquid. Modes: PAPER,LIVE.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
# Enable public Hyperliquid scanning and connectivity. Consumer: alphaforge.exchange_market_scanner._scan_hyperliquid. Modes: PAPER,LIVE.
HYPERLIQUID_ENABLED=true
# Minimum execution-adjusted RR. Consumer: alphaforge.order.evaluate_trade_quality. Modes: BACKTEST,PAPER,LIVE.
MIN_EFFECTIVE_RR=1.6
# Minimum 24h liquidity. Consumer: alphaforge.execution.build_execution_cost_breakdown. Modes: BACKTEST,PAPER,LIVE.
MIN_LIQUIDITY_USD=5000000.0
# Telegram bot token. Consumer: alphaforge.telegram_alert_delivery.telegram_alert_provider_from_config. Modes: PAPER,LIVE.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram destination chat identifier. Consumer: alphaforge.telegram_alert_delivery.telegram_alert_provider_from_config. Modes: PAPER,LIVE.
TELEGRAM_CHAT_ID=your_telegram_chat_id

