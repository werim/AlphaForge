# AlphaForge MEDIUM environment profile (balanced PAPER/default; LIVE disabled)
# Purpose-specific templates are available:
# - .env.test.example: loose BACKTEST/local diagnostics (NOT LIVE)
# - .env.medium.example: balanced PAPER/default evaluation
# - .env.live.example: hardened LIVE preparation; requires explicit credentials/evidence/guards
# Copy one profile to .env and set real secrets locally. Never commit .env.

# Environment
ALPHAFORGE_ENVIRONMENT=dev # Runtime environment label: dev/test/prod
ALPHAFORGE_TIMEZONE=UTC # Operational timezone for logs/scheduling

# Runtime Mode
ALPHAFORGE_EXECUTION_MODE=PAPER # BACKTEST | PAPER | LIVE (canonical runtime mode)
EXECUTION_MODE=PAPER # Backward-compatible runtime mode alias
ALPHAFORGE_ENABLE_BACKTEST=true # Enable backtest workflows/tools
ALPHAFORGE_ENABLE_PAPER_TRADING=true # Enable paper execution path
ALPHAFORGE_ENABLE_LIVE_TRADING=false # Keep LIVE disabled by default
ALPHAFORGE_ALLOW_LIVE_ORDERS=false # Hard safety gate for real order placement
ALPHAFORGE_REQUIRE_LIVE_QUALIFICATION=true # Enforce readiness gate before LIVE startup
ALPHAFORGE_ENABLE_SHADOW_MODE=true # Required for controlled LIVE qualification rollout
ALPHAFORGE_ENABLE_CANARY_MODE=true # Required for controlled LIVE qualification rollout
ALPHAFORGE_OPERATOR_LIVE_ACKNOWLEDGED=false # Manual operator ack required before LIVE
ALPHAFORGE_GLOBAL_KILL_SWITCH=false # Emergency stop for runtime order flow
ALPHAFORGE_DRY_RUN=true # Safety default for scripts/adapters that support dry-run behavior

# Exchange / Binance
BINANCE_BASE_URL=https://fapi.binance.com # Binance Futures REST base URL
BINANCE_WS_URL=wss://fstream.binance.com/ws # Binance Futures websocket base URL
BINANCE_TESTNET=true # Use testnet endpoints where supported
BINANCE_DEFAULT_QUOTE_ASSET=USDT # Default quote asset for universe selection
BINANCE_DEFAULT_MARKET_TYPE=USDT_M # Preferred market type: USDT_M | COIN_M
BINANCE_RECV_WINDOW_MS=5000 # Signed request receive window
BINANCE_REQUEST_TIMEOUT_SEC=10 # HTTP timeout for venue calls
ALPHAFORGE_ENABLE_BINANCE_READONLY_RECONCILIATION=false # Enable authenticated READ-ONLY Binance reconciliation evidence in LIVE
ALPHAFORGE_BINANCE_RECV_WINDOW_MS=5000 # Binance signed USER_DATA recvWindow for reconciliation requests
ALPHAFORGE_RECONCILIATION_POSITION_EPSILON=0.00000001 # Ignore position quantity dust at or below this absolute value
ALPHAFORGE_RECONCILIATION_MAX_FILL_SYMBOLS=20 # Fail closed rather than fan out beyond this many relevant fill symbols
ALPHAFORGE_RECONCILIATION_RECENT_LIFECYCLE_LOOKBACK_MS=86400000 # Bound local recent-lifecycle fill scope to 24 hours
ALPHAFORGE_BINANCE_RECONCILIATION_TRADE_LOOKBACK_MS=3600000 # Bounded userTrades lookback window for reconciliation fills

# Hyperliquid
HYPERLIQUID_ENABLED=false # Enable Hyperliquid adapter integration when implemented
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz # Hyperliquid HTTP API base URL
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws # Hyperliquid websocket endpoint
HYPERLIQUID_TESTNET=true # Prefer testnet/sandbox where supported

# API Keys
BINANCE_API_KEY=your_binance_api_key_here # Binance API key (READ-ONLY reconciliation evidence only; not execution)
BINANCE_API_SECRET=your_binance_api_secret_here # Binance API secret (READ-ONLY reconciliation evidence only; not execution)
HYPERLIQUID_API_KEY=your_hyperliquid_api_key_here # Hyperliquid API key
HYPERLIQUID_API_SECRET=your_hyperliquid_api_secret_here # Hyperliquid API secret

# Risk Engine
ALPHAFORGE_RISK_PCT_PER_TRADE=0.5 # Conservative risk per trade (% equity)
ALPHAFORGE_MAX_DAILY_LOSS_PCT=2.0 # Daily max drawdown guard (% equity)
ALPHAFORGE_MAX_OPEN_POSITIONS=3 # Legacy alias for ALPHAFORGE_MAX_CONCURRENT_POSITIONS
ALPHAFORGE_MAX_NOTIONAL_EXPOSURE=100000 # Portfolio notional cap
ALPHAFORGE_MAX_SYMBOL_NOTIONAL=50000 # Per-symbol notional cap
ALPHAFORGE_SYMBOL_COOLDOWN_SEC=120 # Cooldown per symbol between entries
ALPHAFORGE_STALE_MARKET_DATA_SEC=15 # Reject if market data older than this
MAX_CORRELATED_POSITIONS=2 # Correlation exposure cap across similar symbols
REJECT_UNKNOWN_EXPECTANCY=true # Reject trades when expectancy context is unknown

# Execution
ALPHAFORGE_MIN_SIGNAL_SCORE=0.62 # Canonical AI accept threshold used by runtime
ALPHAFORGE_MIN_ACCEPT_SCORE=0.62 # Legacy alias for ALPHAFORGE_MIN_SIGNAL_SCORE
ALPHAFORGE_MIN_TRADE_SCORE=0.50 # Strategy score threshold (non-runtime legacy)
ALPHAFORGE_MIN_RR=1.20 # Minimum raw RR before execution penalties
MIN_EFFECTIVE_RR=1.60 # Minimum execution-adjusted RR; conservative default after negative accepted-trade audit
ALPHAFORGE_MAX_CONCURRENT_POSITIONS=3 # Runtime concurrent position cap
ALPHAFORGE_SCAN_INTERVAL_SEC=1.0 # Runtime market scan cadence
ALPHAFORGE_HEARTBEAT_INTERVAL_SEC=30.0 # Runtime heartbeat cadence
ALPHAFORGE_RECONCILIATION_INTERVAL_SEC=5.0 # Reconciliation loop interval
ALPHAFORGE_RECONCILIATION_TIMEOUT_SEC=2.0 # Reconciliation timeout bound

# Slippage / Spread
MAX_SPREAD_BPS=25 # Max spread threshold in basis points
MAX_SLIPPAGE_BPS=20 # Max expected slippage threshold in basis points
ALPHAFORGE_MAX_SPREAD_PCT=0.0025 # Runtime spread limit as percent
ALPHAFORGE_MAX_EXPECTED_SLIPPAGE_PCT=0.0020 # Runtime slippage limit as percent
ALPHAFORGE_MAX_ABS_FUNDING_RATE_PCT=0.0010 # Funding-risk guard as absolute percent
ALPHAFORGE_TAKER_FEE_PCT=0.040 # Assumed taker fee percent for planning
ALPHAFORGE_MAKER_FEE_PCT=0.020 # Assumed maker fee percent for planning
MIN_LIQUIDITY_USD=5000000 # Minimum 24h quote liquidity for tradability
ENABLE_ORDERBOOK_FILTER=true # Use orderbook quality gating
ENABLE_SPOOF_DETECTION=false # Enable spoof-risk detection (off until validated)
ENABLE_ABSORPTION_FILTER=false # Enable absorption/flow filter (off until validated)
ENABLE_REGIME_FILTER=true # Enforce regime-aware filter gating

# Backtest
ALPHAFORGE_BACKTEST_INITIAL_BALANCE=1000 # Default backtest starting balance
ALPHAFORGE_BACKTEST_RISK_PCT=1.0 # Backtest risk per trade
ALPHAFORGE_BACKTEST_TIMEFRAME=1m # Candle timeframe
ALPHAFORGE_BACKTEST_TOP_N=100 # Universe size cap
ALPHAFORGE_BACKTEST_LAST_N_DAYS=7 # Default backtest horizon (days)
ALPHAFORGE_BACKTEST_OUTPUT_DIR=data/backtest # Backtest export directory
ALPHAFORGE_BACKTEST_OFFLINE=false # Use deterministic fixtures instead of network
ALPHAFORGE_BACKTEST_CI=false # CI-safe offline mode


# -----------------------------------------------------------------------------
# BACKTEST EXPERIMENTAL REAL FILTER SWITCHES
# -----------------------------------------------------------------------------
# BACKTEST-only real decision switches.
# All default to true to preserve conservative baseline behavior.
# Setting one to false disables that rejection gate during BACKTEST only.
# PAPER/LIVE ignore these switches.
# These are not dashboard display filters.
# Disabling filters can increase accepted trades and worsen expectancy.

ALPHAFORGE_BACKTEST_FILTER_LOW_SCORE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_TOO_CHOPPY_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_WEAK_TREND_NO_RANGE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_STOP_TOO_WIDE_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_RR_TOO_LOW_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_DAILY_SYMBOL_TRADE_LIMIT_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_REGIME_MISMATCH_ENABLED=true
ALPHAFORGE_BACKTEST_FILTER_PANIC_CONDITIONS_ENABLED=true

# BACKTEST-only SHORT breakdown rescue experiment. Disabled by default; when
# disabled, AlphaForge only exports reporting diagnostics and baseline behavior is unchanged.
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ENABLED=false
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MAX_PER_DAY=1
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ALLOWED_REASONS=LOW_SCORE,STOP_TOO_WIDE,DAILY_SYMBOL_TRADE_LIMIT
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_EFFECTIVE_RR=1.10
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_MIN_SHADOW_EXPECTANCY=0.00
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_SIZE_MULTIPLIER=0.25
ALPHAFORGE_BACKTEST_SHORT_LOW_SCORE_BREAKDOWN_DIAGNOSTIC_SYMBOLS=BTCUSDT,ETHUSDT

# Persistence
ALPHAFORGE_DATABASE_URL=sqlite:///./alphaforge.db # Canonical runtime DB URL
ALPHAFORGE_DB_URL=sqlite:///./alphaforge.db # Legacy alias for ALPHAFORGE_DATABASE_URL
ALPHAFORGE_SQLITE_PATH=sqlite:///./alphaforge.db # SQLite DB path fallback
ALPHAFORGE_POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/alphaforge # Postgres URL for non-dev env
ALPHAFORGE_DB_ECHO=false # SQLAlchemy echo SQL logs
ALPHAFORGE_EXPORT_VERIFY_INTEGRITY=true # Fail exports on lifecycle/reject mismatch

# Redis / Queue
REDIS_ENABLED=false # Toggle Redis-backed cache/queue integrations
REDIS_URL=redis://localhost:6379/0 # Redis DSN
REDIS_KEY_PREFIX=alphaforge # Key namespace prefix
QUEUE_BACKEND=memory # memory | redis
QUEUE_NAME=alphaforge_runtime # Queue/stream name

# Logging
ALPHAFORGE_LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR
ALPHAFORGE_LOG_FORMAT=json # json | text
ALPHAFORGE_LOG_FILE= # Optional file path; empty = stdout only
ALPHAFORGE_METRICS_HEARTBEAT_ENABLED=true # Emit periodic runtime heartbeat metrics

# Notifications
ALPHAFORGE_ENABLE_NOTIFICATIONS=false # Master notification toggle
ALPHAFORGE_ENABLE_TELEGRAM=false # Telegram notifications toggle
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here # Telegram bot token
TELEGRAM_CHAT_ID=your_telegram_chat_id_here # Telegram target chat
ALPHAFORGE_ENABLE_DISCORD=false # Discord notifications toggle
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me # Discord webhook URL

# Feature Flags
ALPHAFORGE_ENABLE_LIVE_READINESS=true # Enable live-readiness evaluator subsystem
ALPHAFORGE_ENABLE_RECONCILIATION=true # Enable reconciliation control-plane loop
ALPHAFORGE_ENABLE_REJECT_SHADOW_ANALYTICS=true # Enable rejected-trade shadow evaluation summaries

# Experimental
ALPHAFORGE_EXPERIMENTAL_EXCHANGE_REPAIR=false # Allow automated exchange repair actions
ALPHAFORGE_EXPERIMENTAL_ADAPTIVE_THRESHOLDS=false # Enable adaptive threshold experiments

# Debug
ALPHAFORGE_DEBUG=false # Global debug toggle
ALPHAFORGE_TRACE_LIFECYCLE=false # Verbose lifecycle transition tracing
ALPHAFORGE_DUMP_EXECUTION_CTX=false # Emit execution context payloads for diagnostics

# RESERVED_NOT_WIRED
RESERVED_NOT_WIRED=ALPHAFORGE_ENVIRONMENT,ALPHAFORGE_TIMEZONE,...

# -----------------------------------------------------------------------------
# MODE-AWARE MANAGED CONFIG REGISTRY (Dashboard Settings source of truth)
# Format: NAME=default # category | applies_to | restart_required | behavior
# -----------------------------------------------------------------------------
ALPHAFORGE_MAX_TRADES_GLOBAL_PER_DAY=10 # Runtime Risk Limits | PAPER,LIVE | restart required | Runtime global daily cap; ignored by BACKTEST by default
ALPHAFORGE_MAX_TRADES_SYMBOL_PER_DAY=2 # Runtime Risk Limits | PAPER,LIVE | restart required | Runtime symbol daily cap; ignored by BACKTEST by default
ALPHAFORGE_SYMBOL_LOSS_STREAK_LIMIT=3 # Runtime Risk Limits | PAPER,LIVE | restart required | Symbol loss-streak block threshold
ALPHAFORGE_GLOBAL_LOSS_STREAK_LIMIT=5 # Runtime Risk Limits | PAPER,LIVE | restart required | Global loss-streak block threshold
ALPHAFORGE_MIN_SL_PCT=0.15 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Minimum stop distance percent
ALPHAFORGE_MAX_SL_PCT=1.5 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Maximum stop distance percent
ALPHAFORGE_MIN_ATR_PCT=0.25 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Minimum ATR percent when available
ALPHAFORGE_MAX_ATR_PCT=3.0 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Maximum ATR percent when available
ALPHAFORGE_BLOCK_UNKNOWN_EXPECTANCY=true # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Reject unknown expectancy
ALPHAFORGE_BLOCK_CHOP_MARKET=true # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Reject chop-pattern candidates
ALPHAFORGE_REQUIRE_REGIME_ALIGNMENT=true # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Enforce setup/regime alignment
ALPHAFORGE_STOP_TOO_WIDE_HARD_REJECT=true # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Hard reject unqualified wide stops
ALPHAFORGE_STOP_TOO_WIDE_SOFT_SCORE_MIN=9.0 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Minimum score for wide-stop softening
ALPHAFORGE_STOP_TOO_WIDE_SOFT_EFFECTIVE_RR_MIN=1.75 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Minimum effective RR for wide-stop softening
ALPHAFORGE_STOP_TOO_WIDE_MAX_RISK_SCALE=0.50 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Max reduced risk scale for softened wide stops
ALPHAFORGE_STOP_TOO_WIDE_EXTREME_MULT=1.50 # Trade Quality Filters | BACKTEST,PAPER,LIVE | restart required | Extreme wide-stop multiplier
ALPHAFORGE_MAX_LATENCY_MS=2500 # Execution Cost Filters | PAPER,LIVE | restart required | Maximum latency when available
ALPHAFORGE_BACKTEST_MAX_TRADES=0 # Backtest Settings | BACKTEST | no restart for new run | Optional total backtest cap; 0 disables
ALPHAFORGE_BACKTEST_MAX_ACCEPTED_TRADES_PER_DAY=6 # Backtest Settings | BACKTEST | no restart for new run | Conservative DEFAULT accepted/day cap before DAILY_TRADE_FREQUENCY_GUARD
ALPHAFORGE_BACKTEST_MAX_SYMBOL_TRADES_PER_DAY=0 # Backtest Settings | BACKTEST | no restart for new run | Optional symbol/day cap; 0 disables
ALPHAFORGE_BACKTEST_USE_EXECUTION_COSTS=true # Backtest Settings | BACKTEST | no restart for new run | Use execution-cost context when present
ALPHAFORGE_BACKTEST_EXPORT_CONFIG_SNAPSHOT=true # Backtest Settings | BACKTEST | no restart for new run | Export config snapshot for each run when supported
ALPHAFORGE_BACKTEST_SHORT_BREAKDOWN_RESCUE_ENABLED=false # Backtest Settings | BACKTEST | no restart for new run | BACKTEST-only SHORT_BREAKDOWN_RESCUE experiment; disabled by default; no PAPER/LIVE effect
ALPHAFORGE_BACKTEST_SHORT_LOW_SCORE_BREAKDOWN_DIAGNOSTIC_SYMBOLS=BTCUSDT,ETHUSDT # Backtest Settings | BACKTEST | no restart for new run | BACKTEST-only SHORT_LOW_SCORE_BREAKDOWN_DIAGNOSTIC symbol scope; reporting only; no PAPER/LIVE effect

# Strategy Quality Guardrails | BACKTEST only | no restart for new run | Conservative DEFAULT_FILTERS acceptance controls.
ALPHAFORGE_BACKTEST_STRATEGY_GUARDRAILS_ENABLED=true # Enable BACKTEST strategy-quality guardrails; does not alter LIVE order placement
ALPHAFORGE_BACKTEST_STRATEGY_PROFILE=DEFAULT_FILTERS # DEFAULT_FILTERS is conservative; HIGH_VOL_MOMENTUM_DIAGNOSTIC is diagnostic-only
ALPHAFORGE_BACKTEST_MAX_CONSECUTIVE_SL_PAUSE=4 # Pause DEFAULT acceptance after this many consecutive realized SLs via LOSS_STREAK_PAUSE
ALPHAFORGE_BACKTEST_SCORE10_SL_DOMINANCE_GUARD=true # Require secondary quality for saturated score>=9.8 candidates
ALPHAFORGE_BACKTEST_HIGH_VOL_ACCEPTANCE_GUARD=true # Require stronger RR/cost limits and daily caps for high-vol candidates
ALPHAFORGE_BACKTEST_MIN_PROFIT_FACTOR_FOR_PROFILE_PASS=1.20 # Minimum profile profit factor for strategy-quality PASS
ALPHAFORGE_BACKTEST_MAX_LOSS_STREAK_FOR_PROFILE_PASS=6 # Maximum longest loss streak for strategy-quality PASS
ALPHAFORGE_BACKTEST_MAX_DRAWDOWN_PCT_FOR_PROFILE_PASS=12.0 # Maximum absolute drawdown percent for strategy-quality PASS
